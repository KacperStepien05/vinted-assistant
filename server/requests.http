### VALID EMAIL AND PASSWORD
POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "supersecret"
}

### WRONG MAIL VALID PASSWORD
POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "email": "testexample.com",
  "password": "supersecret"
}

### VALID EMAIL WRONG PASSWORD
POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "email": "test@examplee.com",
  "password": "test"
}

### DUPLICATE EMAIL
POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "supersecret"
}

### DUPLICATE WITH DIFFERENT CASE + SPACES
POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "email": "  TEST@Example.com ",
  "password": "supersecret"
}

### VALID EMAIL AND PASSWORD (GET)
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "supersecret"
}

### VALID EMAIL WRONG PASSWORD (GET)
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "supersecret1"
}

### WRONG EMAIL VALID PASSWORD (GET)
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "test1@example.com",
  "password": "supersecret"
}


### LOGIN OK
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "supersecret"
}

### ME (logged in)
GET http://localhost:3000/auth/me

### ME (fake cookie, should be 401)
GET http://localhost:3000/auth/me
Cookie: connect.sid=fake

### LOGOUT
POST http://localhost:3000/auth/logout

### GET ITEMS
GET http://localhost:3000/items

### CREATE ITEM
POST http://localhost:3000/items
Content-Type: application/json

{
  "title": "Nike Tech Fleece hoodie",
  "brand": "Nike",
  "size": "M",
  "buyPrice": 4000,
  "listPrice": 8500
}

### CREATE ITEM (FAILED TITLE)
POST http://localhost:3000/items
Content-Type: application/json

{
  "title": ""
}

### CREATE ITEM - NEGATIVE PRICE (expect 400)
POST http://localhost:3000/items
Content-Type: application/json

{
  "title": "Test",
  "listPrice": -5
}

### CREATE ITEM - DECIMAL PRICE (expect 400)
POST http://localhost:3000/items
Content-Type: application/json

{
  "title": "Test",
  "listPrice": 49.99
}

### GET ITEM WITH ID
GET http://localhost:3000/items/1

### GET ITEM WITH WRONG ID
GET http://localhost:3000/items/999

### GET ITEM WITH WRONG ID (NOT NUM)
GET http://localhost:3000/items/abc